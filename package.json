{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "iterm-profiles",
  "title": "iTerm Profiles",
  "description": "Extension to easily open your iTerm profiles",
  "icon": "command-icon.png",
  "author": "Boschman",
  "categories": [
    "Developer Tools",
    "System",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Open iTerm Profile",
      "description": "Open an iTerm profile",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.5.3",
    "@raycast/utils": "^2.3.2",
    "bplist-parser": "^0.5.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  }
}
