{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "iterm-profiles",
  "title": "iTerm Profiles",
  "description": "Extension to easily open your iTerm profiles",
  "icon": "command-icon.png",
  "author": "Boschman",
  "categories": [
    "Developer Tools",
    "System",
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Open iTerm Profile",
      "description": "Open an iTerm profile",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.48.5",
    "@raycast/utils": "^1.5.2",
    "bplist-parser": "^0.3.2",
    "run-applescript": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "18.0.9",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "prettier": "^2.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish"
  }
}
